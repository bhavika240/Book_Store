
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Cart | Read Me</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-[#F7F2EA] text-[#403447]">

    <%- include('includes/nav.ejs') %>

    <section class="max-w-5xl mx-auto px-6 py-12">

        <h1 class="text-4xl font-serif mb-3">My Shopping Cart</h1>
        <p class="text-[#655873] mb-8">
            Your selected books are here.
        </p>

        <% if (cartItems.length === 0) { %>

            <div class="bg-white rounded-2xl p-10 text-center border border-[#E5D9F2]">
                <h2 class="text-2xl font-serif mb-3">Your cart is empty</h2>

                <p class="text-[#655873] mb-6">
                    Discover a book you would love to read!
                </p>

                <a href="/books"
                   class="inline-block bg-[#8064A2] text-white px-6 py-3 rounded-full hover:bg-[#6B508B]">
                    Browse Books
                </a>
            </div>

        <% } else { %>

            <div class="space-y-4">

                <% cartItems.forEach(item => { %>

                    <div class="bg-white rounded-2xl p-5 border border-[#E5D9F2] flex flex-col sm:flex-row gap-5 items-center">

                        <img
                            src="<%= item.book.image %>"
                            alt="<%= item.book.title %>"
                            class="w-40 h-52 object-contain rounded-lg bg-[#F7F1EA] p-3"
                        >

                        <div class="flex-1 text-center sm:text-left">

                            <h2 class="text-xl font-bold">
                                <%= item.book.title %>
                            </h2>

                            <p class="text-[#655873] mt-1">
                                by <%= item.book.author %>
                            </p>

                            <p class="text-[#8064A2] font-semibold mt-2">
                                ₹<%= Number(item.book.price) %> × <%= item.quantity %>
                            </p>

                        </div>

                        <div class="text-center">

                            <p class="text-lg font-bold mb-3">
                                ₹<%= Number(item.book.price) * Number(item.quantity) %>
                            </p>

                            <form
                                action="/cart/remove/<%= item.book._id %>"
                                method="POST"
                            >
                                <button
                                    type="submit"
                                    class="bg-red-700 text-white px-4 py-2 rounded-lg hover:bg-red-800">
                                    Remove
                                </button>
                            </form>

                        </div>

                    </div>

                <% }) %>

            </div>

            <div class="bg-white rounded-2xl p-6 mt-8 border border-[#E5D9F2]">

                <div class="flex justify-between items-center gap-4">
                    <h2 class="text-xl font-bold">Total Amount</h2>

                    <p class="text-2xl font-bold text-[#8064A2]">
                        ₹<%= total %>
                    </p>
                </div>

                <div class="flex flex-wrap gap-4 mt-6">

                    <a
                        href="/books"
                        class="inline-block bg-[#8064A2] text-white px-6 py-3 rounded-full hover:bg-[#6B508B]">
                        Continue Shopping
                    </a>

                    <form action="/cart/buy" method="POST">

                        <button
                            type="submit"
                            class="bg-[#49372D] text-white px-8 py-3 rounded-full hover:bg-[#35271F] transition">
                            Buy Now
                        </button>

                    </form>

                </div>

            </div>

        <% } %>

    </section>

    <%- include('includes/footer.ejs') %>

</body>
</html>
